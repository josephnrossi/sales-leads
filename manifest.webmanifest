{
  "name": "Gilman Sales Leads",
  "short_name": "Sales Leads",
  "description": "Smart B2B lead finder for Gilman foam board: ranked, verified printers, display makers, OEMs and retailers.",
  "id": "/sales-leads/",
  "start_url": "/sales-leads/",
  "scope": "/sales-leads/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "prefer_related_applications": false,
  "categories": [
    "business",
